GeckoProgram("naivefox", linkage="dependent")

SOURCES += [
    "NaiveFox.cpp",
]

DIRS += ["codec", "core"]

if CONFIG["ENABLE_TESTS"]:
    # NaiveFox suppresses the tree-wide TEST_DIRS traversal and opts into only
    # its lifecycle-focused gtests through an ordinary directory edge.
    DIRS += ["test/gtest"]
