# NaiveFox Windows x86_64 product build.
# The compiler, linker, Visual Studio and Windows SDK are supplied by the
# build environment; keep their paths out of the source tree.
if test -n "$NAIVEFOX_OBJDIR"; then
  mk_add_options MOZ_OBJDIR="$NAIVEFOX_OBJDIR"
else
  mk_add_options MOZ_OBJDIR=@TOPSRCDIR@/obj-naivefox-windows-x86_64
fi

ac_add_options --target=x86_64-pc-windows-msvc
ac_add_options --enable-project=netwerk/naivefox
ac_add_options --with-app-basename=NaiveFox
ac_add_options --with-app-name=naivefox

ac_add_options --disable-tests
ac_add_options --disable-crashreporter
ac_add_options --disable-profiling
ac_add_options --disable-backgroundtasks
ac_add_options --disable-sandbox
ac_add_options --disable-updater
ac_add_options --disable-webrtc
ac_add_options --disable-accessibility
ac_add_options --disable-necko-wifi
ac_add_options --without-wasm-sandboxed-libraries

export CC="${CC:-clang-cl}"
export CXX="${CXX:-clang-cl}"
export LINKER="${LINKER:-lld-link}"
