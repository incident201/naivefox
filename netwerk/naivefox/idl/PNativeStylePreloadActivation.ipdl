include protocol PNativeStylePreloadActivationRequest;
include NativeStylePreloadActivationTypes;

namespace mozilla {
namespace naivefox {

[ChildProc=any, ChildImpl=virtual, ParentImpl=virtual]
async protocol PNativeStylePreloadActivation {
  manages PNativeStylePreloadActivationRequest;
parent:
  async Warmup(uint8_t leg);
  async PNativeStylePreloadActivationRequest(uint64_t requestId,
                                             uint8_t kind,
                                             uint8_t leg);

child:
  async WarmupAck(uint8_t leg);
};

}  // namespace naivefox
}  // namespace mozilla
