namespace mozilla {
namespace dom {

union PrefValue {
  nsCString;
  int32_t;
  bool;
};

struct Pref {
  nsCString name;
  bool isLocked;
  bool isSanitized;
  PrefValue? defaultValue;
  PrefValue? userValue;
};

} // namespace dom
} // namespace mozilla
