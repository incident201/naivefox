# NaiveFox Android ARM64 embedded product build. The Android SDK and Gradle
# application toolchain are intentionally not part of this native target.
if test -n "$NAIVEFOX_OBJDIR"; then
  mk_add_options MOZ_OBJDIR="$NAIVEFOX_OBJDIR"
else
  mk_add_options MOZ_OBJDIR=@TOPSRCDIR@/obj-naivefox-android-aarch64
fi

ac_add_options --target=aarch64-linux-android
ac_add_options --with-android-version=26
ac_add_options --enable-bootstrap=android-ndk
ac_add_options --enable-project=netwerk/naivefox
ac_add_options --with-app-basename=NaiveFox
ac_add_options --with-app-name=naivefox
ac_add_options --build-backends=RecursiveMake

ac_add_options --disable-tests
ac_add_options --disable-crashreporter
ac_add_options --disable-profiling
ac_add_options --disable-backgroundtasks
ac_add_options --disable-sandbox
ac_add_options --disable-updater
ac_add_options --disable-webrtc
ac_add_options --disable-ctypes
ac_add_options --disable-accessibility
ac_add_options --without-wasm-sandboxed-libraries
ac_add_options --without-intl-api

if test -z "${NAIVEFOX_DISABLE_SCCACHE:-}" && test -x "$HOME/.mozbuild/sccache/sccache"; then
  ac_add_options --with-ccache="$HOME/.mozbuild/sccache/sccache"
fi
