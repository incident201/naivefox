namespace mozilla {
namespace naivefox {

[ChildProc=any, ChildImpl=virtual, ParentImpl=virtual, NeedsOtherPid]
async protocol PNativeStylePreloadProcess {
parent:
  async Hello(uint64_t childPid, uint64_t observedParentPid);

child:
  async Shutdown();
};

}  // namespace naivefox
}  // namespace mozilla
