namespace mozilla {
namespace naivefox {

struct NativeStylePreloadActivationArgs {
  uint64_t requestId;
  nsCString resourceSpec;
  nsCString documentSpec;
  nsCString referrerSpec;
  nsCString originAttributesSuffix;
  uint8_t referrerPolicy;
  bool sendReferrer;
  uint8_t preloadKind;
};

[ChildProc=any, ChildImpl=virtual, ParentImpl=virtual]
async protocol PNativeStylePreloadActivation {
parent:
  async Warmup(uint8_t leg);
  async PrimaryOpen(NativeStylePreloadActivationArgs args);
  async BackgroundReady(uint64_t requestId);

child:
  async WarmupAck(uint8_t leg);
};

}  // namespace naivefox
}  // namespace mozilla
