include protocol PNativeStylePreloadProcess;
include NativeStylePreloadActivationTypes;

namespace mozilla {
namespace naivefox {

[ChildProc=any, ChildImpl=virtual, ParentImpl=virtual]
async protocol PNativeStylePreloadProcessStyle {
  manager PNativeStylePreloadProcess;
parent:
  async __delete__();

child:
  async CompleteStyle(uint64_t styleRequestId, uint64_t rootRequestId,
                      uint64_t rootGeneration, nsresult status);
};

}  // namespace naivefox
}  // namespace mozilla
