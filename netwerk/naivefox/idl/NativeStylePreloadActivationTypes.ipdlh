namespace mozilla {
namespace naivefox {

struct NativeStylePreloadActivationArgs {
  uint64_t requestId;
  nsCString resourceSpec;
  nsCString documentSpec;
  nsCString referrerSpec;
  nsCString originAttributesSuffix;
  uint8_t referrerPolicy;
  bool sendReferrer;
  uint8_t preloadKind;
};

struct NativeRootReplacementActivationArgs {
  uint64_t requestId;
  uint64_t channelId;
  nsCString resourceSpec;
  nsCString originalSpec;
  nsCString originAttributesSuffix;
  nsCString referrerSpec;
  uint8_t referrerPolicy;
  bool sendReferrer;
  uint32_t loadFlags;
  uint32_t contentPolicyType;
  uint32_t httpStatus;
  nsCString contentType;
  nsCString charset;
  uint64_t generation;
};

}  // namespace naivefox
}  // namespace mozilla
